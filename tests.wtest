            nivelEnergiaInicial = 3000,
            potencialOfensivo = 50,
            nivelExperiencia = 0,
            nivelEnergia = 3000,
            traje = new TrajeModularizado(
                piezas = [new Piezas(resistencia=1), new Piezas(resistencia=2), new Piezas(resistencia=3)]
            )
         ) 
        torneo.cambiarModalidad(funny)
        torneo.inscripcion([goku, vegeta, gohan])

        assert.equals([gohan, vegeta], torneo.participantes())
    }
    
