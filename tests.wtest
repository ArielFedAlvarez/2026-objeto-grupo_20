import solucion.*

describe "guerreros" {

    test "Despues de recibir un ataque, el guerrero atacado disminuye 
    su energia en un 10% del potencial ofensivo del guerrero atacante" {

        const goku = new Guerrero (
        nivelEnergiaInicial = 1000,
        potencialOfensivo = 100,
        nivelExperiencia = 0,
        nivelEnergia = 100,
        traje = new TrajeComun(porcentajeProteccion = 0)
        )
        const vegeta = new Guerrero (
        nivelEnergiaInicial = 5000,
        potencialOfensivo = 100,
        nivelExperiencia = 0,
        nivelEnergia = 5000,
        traje = new TrajeComun(porcentajeProteccion = 0)
        )

        goku.atacarAGuerrero(vegeta)

        assert.equals(4990, vegeta.nivelEnergia())
    } 

    test "Al ser atacado, un guerrero aumenta su experiencia en un punto" {

        const goku = new Guerrero (
        nivelEnergiaInicial = 1000,
        potencialOfensivo = 100,
        nivelExperiencia = 0,
        nivelEnergia = 100,
        traje = new TrajeComun(porcentajeProteccion = 0)
        )
        const vegeta = new Guerrero (
        nivelEnergiaInicial = 5000,
        potencialOfensivo = 100,
        nivelExperiencia = 0,
        nivelEnergia = 5000,
        traje = new TrajeComun(porcentajeProteccion = 0)
        )

        goku.atacarAGuerrero(vegeta)

        assert.equals(1,vegeta.nivelExperiencia())
    }

    test "Cuando un guerrero come una semilla del ermitaño, su nivel de energía es restaurado al original" {

        const goku = new Guerrero (
        nivelEnergiaInicial = 1000,
        potencialOfensivo = 100,
        nivelExperiencia = 0,
        nivelEnergia = 100,
        traje = new TrajeComun(porcentajeProteccion = 0)
        )
        const vegeta = new Guerrero (
        nivelEnergiaInicial = 5000,
        potencialOfensivo = 100,
        nivelExperiencia = 0,
        nivelEnergia = 5000,
        traje = new TrajeComun(porcentajeProteccion = 0)
        )

        goku.atacarAGuerrero(vegeta)
        vegeta.comerSemillaErmitanio()

        assert.equals(5000,vegeta.nivelEnergia())
    }
    
    test "Cuando la energia de un guerrero llega a cero, el mismo muere" {

        const goku = new Guerrero (
        nivelEnergiaInicial = 1000,
        potencialOfensivo = 100,
        nivelExperiencia = 0,
        nivelEnergia = 100,
        traje = new TrajeComun(porcentajeProteccion = 0)
        )
        const vegeta = new Guerrero (
        nivelEnergiaInicial = 10,
        potencialOfensivo = 100,
        nivelExperiencia = 0,
        nivelEnergia = 10,
        traje = new TrajeComun(porcentajeProteccion = 0)
        )

        goku.atacarAGuerrero(vegeta)

        assert.that(vegeta.estaMuerto())
    }

    test "La energia de un guerrero no baja mas alla de cero por mas que siga siendo atacado" {

        const goku = new Guerrero (
        nivelEnergiaInicial = 1000,
        potencialOfensivo = 100,
        nivelExperiencia = 0,
        nivelEnergia = 100,
        traje = new TrajeComun(porcentajeProteccion = 0)
        )
        const vegeta = new Guerrero (
        nivelEnergiaInicial = 10,
        potencialOfensivo = 100,
        nivelExperiencia = 0,
        nivelEnergia = 10,
        traje = new TrajeComun(porcentajeProteccion = 0)
        )

        goku.atacarAGuerrero(vegeta)
        goku.atacarAGuerrero(vegeta)

        assert.equals(0,vegeta.nivelEnergia())
    }
}

describe "trajes" {

    const goku = new Guerrero (
    nivelEnergiaInicial = 1000,
    potencialOfensivo = 100,
    nivelExperiencia = 0,
    nivelEnergia = 1000,
    traje = new TrajeComun(porcentajeProteccion = 0)
    )
    const vegeta = new Guerrero (
    nivelEnergiaInicial = 5000,
    potencialOfensivo = 100,
    nivelExperiencia = 0,
    nivelEnergia = 5000,
    traje = new TrajeComun(porcentajeProteccion = 3)
    )

    test "Un guerrero con un traje comun de 3% de proteccion recibe menos daño" {
        goku.atacarAGuerrero(vegeta)

        assert.equals(4993, vegeta.nivelEnergia())
    }

    test "Con traje comun la experiencia aumenta en un punto al ser atacado" {
        goku.atacarAGuerrero(vegeta)

        assert.equals(1, vegeta.nivelExperiencia())
    }

    test "Un traje de entrenamiento no disminuye el daño recibido" {
        vegeta.cambiarTraje(new TrajeDeEntrenamiento())
        goku.atacarAGuerrero(vegeta)

        assert.equals(4990, vegeta.nivelEnergia())
    }

    test "Con traje de entrenamiento la experiencia aumenta el doble al ser atacado" {
        vegeta.cambiarTraje(new TrajeDeEntrenamiento())
        goku.atacarAGuerrero(vegeta)

        assert.equals(2, vegeta.nivelExperiencia())
    }

    test "Si cambia el multiplicador de los trajes de entrenamiento cambia para todos" {
        const gohan = new Guerrero (
        nivelEnergiaInicial = 3000,
        potencialOfensivo = 50,
        nivelExperiencia = 0,
        nivelEnergia = 3000,
        traje = new TrajeDeEntrenamiento()
        )
        vegeta.cambiarTraje(new TrajeDeEntrenamiento())
        trajesDeEntrenamiento.multiplicadorExperiencia(3)

        goku.atacarAGuerrero(vegeta)
        goku.atacarAGuerrero(gohan)

        assert.equals(3, vegeta.nivelExperiencia())
        assert.equals(3, gohan.nivelExperiencia())
    }

    test "Un guerrero puede cambiar de traje antes de una pelea" {
        const trajeNuevo = new TrajeDeEntrenamiento()
        vegeta.cambiarTraje(trajeNuevo)

        assert.equals(trajeNuevo, vegeta.traje())
    }
}
